{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": ["src/lib", "src/hooks/useForm", "src/devtools", "src/resolvers"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.type-test.ts",
    "src/examples",
    "src/stories",
    "src/App.tsx",
    "src/main.tsx",
    "src/test"
  ]
}
